{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProtocolGraph",
  "description": "A structured decision/protocol graph extracted from a PDF document.",
  "type": "object",
  "required": ["protocol_id", "title", "source_pdf", "pages", "protocol_type", "nodes", "edges"],
  "properties": {
    "protocol_id": {
      "type": "string",
      "description": "Unique identifier for this protocol (e.g., 'fire_evacuation_01')."
    },
    "title": {
      "type": "string",
      "description": "Human-readable protocol title."
    },
    "source_pdf": {
      "type": "string",
      "description": "Filename of the source PDF."
    },
    "pages": {
      "type": "array",
      "items": { "type": "integer" },
      "description": "List of 1-based page numbers this protocol spans."
    },
    "protocol_type": {
      "type": "string",
      "enum": ["sequential", "decision_tree", "table", "hybrid"],
      "description": "Dominant format of the protocol in the source document."
    },
    "extraction_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Overall confidence score for this extraction (0-1)."
    },
    "cross_references": {
      "type": "array",
      "items": { "type": "string" },
      "description": "References to other protocols or appendices mentioned in this protocol.",
      "default": []
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/definitions/Node" },
      "minItems": 1
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/definitions/Edge" }
    }
  },
  "definitions": {
    "Node": {
      "type": "object",
      "required": ["id", "type", "text"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique node identifier within this protocol (e.g., 'n1')."
        },
        "type": {
          "type": "string",
          "enum": ["start", "end", "action", "decision"],
          "description": "Node type: start/end markers, action steps, or decision points."
        },
        "text": {
          "type": "string",
          "description": "The text content of this node."
        },
        "evidence": {
          "$ref": "#/definitions/Evidence"
        }
      }
    },
    "Edge": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": {
          "type": "string",
          "description": "Source node ID."
        },
        "to": {
          "type": "string",
          "description": "Target node ID."
        },
        "condition": {
          "type": "string",
          "description": "Condition label for this edge (e.g., 'Yes', 'No', 'If smoke visible')."
        }
      }
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "description": "1-based page number where this content appears."
        },
        "bbox": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4,
          "description": "Bounding box [x0, y0, x1, y1] in PDF coordinates."
        },
        "source_text": {
          "type": "string",
          "description": "Original text as it appears in the source document."
        }
      }
    }
  }
}
